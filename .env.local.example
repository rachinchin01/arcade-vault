# Copiar a .env.local (ignorado por git) y completar con valores reales.

# API key de Resend (https://resend.com/api-keys). Sin esta variable,
# el formulario de contacto de /about muestra un estado de error real.
RESEND_API_KEY=

# Bandeja donde llegan los mensajes del formulario de contacto.
# Default en código si se omite: jhelos@gmail.com
CONTACT_EMAIL_TO=jhelos@gmail.com

# Remitente usado por Resend. Mientras no haya un dominio propio verificado
# en Resend, se usa el dominio sandbox onboarding@resend.dev.
# Default en código si se omite: Arcade Vault <onboarding@resend.dev>
CONTACT_EMAIL_FROM="Arcade Vault <onboarding@resend.dev>"
